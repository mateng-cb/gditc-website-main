# Strapi REST base URL (must end with /api). Admin UI is typically at /admin on the same host (e.g. https://top.gditc.org/admin).
NEXT_PUBLIC_STRAPI_API_URL=https://top.gditc.org/api
# Optional: build-time/server-side only. Never expose as NEXT_PUBLIC_*.
STRAPI_API_TOKEN=your-readonly-token

# CDN
NEXT_PUBLIC_CDN_URL=https://cdn.gditc.org

# Public website URL (Next / static frontend)
NEXT_PUBLIC_SITE_URL=https://gditc.org

REBUILD_TRIGGER_TOKEN=
