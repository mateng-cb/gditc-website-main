{
  "name": "ditc-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:3001": "next dev -p 3001",
    "build": "cross-env GDITC_STATIC_SITE_BUILD=1 next build",
    "start": "next start",
    "start:static": "node start-static-server.js",
    "lint": "next lint",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop all",
    "pm2:restart": "pm2 restart all",
    "pm2:status": "pm2 status",
    "pm2:logs": "pm2 logs",
    "update": "node scripts/enhanced-incremental-updater.js",
    "daily-rebuild": "node scripts/daily-rebuilder.js",
    "clean": "rm -rf .next out node_modules package-lock.json logs .cache"
  },
  "dependencies": {
    "@tailwindcss/line-clamp": "^0.4.4",
    "axios": "^1.6.0",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "form-data": "^4.0.0",
    "formidable": "^3.5.1",
    "next": "14.0.0",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@types/formidable": "^3.4.5",
    "@types/node": "20.19.39",
    "@types/react": "18.3.28",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "cross-env": "^7.0.3",
    "eslint": "^8",
    "eslint-config-next": "14.0.0",
    "postcss": "^8",
    "tailwindcss": "^3.3.0",
    "typescript": "5.9.3"
  }
}
